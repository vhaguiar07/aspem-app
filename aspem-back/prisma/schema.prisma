generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model Autarquias {
  id                         String   @id @default(uuid())
  orgao                      String
  classificacao              String
  matricula                  String
  matriculaSocial            String
  dataAdmissao               DateTime
  nomeSocio                  String
  endereco                   String
  numero                     Int?
  complemento                String?
  bairroResidencia           String
  cidadeResidencia           String
  uf                         String
  cepResidencia              String?
  telefoneResidencia         String?
  telefoneCelular            String?
  telefoneComercial          String?
  falecido                   Boolean?
  cpf                        String?   @unique
  rg                         String?
  orgaoExpedidor             String?
  dataFalecimento            DateTime?
  quantidadeAdventicios      Int?
  quantidadeCooperadores     Int?
  dentCross                  Int?
  odMed                      Int?
  seguro                     Int?
  reversivel                 Boolean?
  valorDescontoSeguro        String?
  morteNatural               String?
  morteAcidental             String?
  invalidezPermanenteAcidente String?
  ps                         Boolean?
  omitido                    Boolean?
  rioPax                     Int?
  dataNascimento             DateTime
  estadoCivil                String?
  email                      String?   @unique
  quantidadeDependentes      Int?
  conjuge                    String?
  descontoSocioEfetivo       String?
  historicoSocio             String?
  observacoesPagamentos      String?
  anoFiscal                  DateTime?
  totalJaneiro               Int?
  totalFevereiro             Int?
  totalMarco                 Int?
  totalAbril                 Int?
  totalMaio                  Int?
  totalJunho                 Int?
  totalJulho                 Int?
  totalAgosto                Int?
  totalSetembro              Int?
  totalOutubro               Int?
  totalNovembro              Int?
  totalDezembro              Int?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  deletedAt                  DateTime?

  adventiciosAutarquia       AdventicioAutarquia[]
  dentCrossesAutarquia       DentCrossAutarquia[]
  odMedsAutarquia            OdMedAutarquia[]
  rioPaxesAutarquia          RioPaxAutarquia[]
  dependentesAutarquia       DependenteAutarquia[]
}

