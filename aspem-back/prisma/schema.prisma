// Modelos Dinâmicos
// Modelos Dinâmicos Autarquias

model AdventicioAutarquia {
  id              String   @id @default(uuid())
  autarquiaId     String
  Autarquias      Autarquias @relation(fields: [autarquiaId], references: [id])
  nomeCompleto    String
}

model DentCrossAutarquia {
  id              String   @id @default(uuid())
  autarquiaId     String
  Autarquias      Autarquias @relation(fields: [autarquiaId], references: [id])
  nomeCompleto    String
}

model OdMedAutarquia {
  id              String   @id @default(uuid())
  autarquiaId     String
  Autarquias      Autarquias @relation(fields: [autarquiaId], references: [id])
  nomeCompleto    String
  data  DateTime?
}

model RioPaxAutarquia {
  id              String   @id @default(uuid())
  autarquiaId     String
